@'
# Python
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/
env/

# Environment variables and secrets
.env
.env.*
!.env.example

# Streamlit
.streamlit/secrets.toml

# Generated reports
reports/
*.log

# IDE
.vscode/
.idea/

# Operating system
.DS_Store
Thumbs.db
desktop.ini
'@ | Set-Content -Path .gitignore -Encoding utf8